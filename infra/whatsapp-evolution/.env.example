# Copy to `.env` and fill in. `.env` is gitignored — never commit real values.
#
#   cp .env.example .env
#   # generate both secrets:
#   python3 -c "import secrets; print('AUTHENTICATION_API_KEY=' + secrets.token_urlsafe(32))" >> .env
#   python3 -c "import secrets; print('POSTGRES_PASSWORD=' + secrets.token_urlsafe(24))" >> .env

# Master key for the Evolution API. Whoever holds it can read your conversations and
# send messages as you — treat it like a password, not a config value.
AUTHENTICATION_API_KEY=

# Postgres password. Only reachable on loopback, but still worth generating.
POSTGRES_PASSWORD=

# Ports on the HOST. Defaults avoid the common ones (8080 and 5432 are often taken);
# change them if these clash on your machine.
EVOLUTION_PORT=8090
POSTGRES_PORT=5433
REDIS_PORT=6380
